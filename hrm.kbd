(defcfg
  input  (device-file "/dev/input/by-id/usb-046a_0023-event-kbd" :ignore-missing true)
  output (uinput-sink "My KMonad output")

  fallthrough true
)

(defsrc
    a    s    d    f    g    h    j    k    l    ;   '
)

(defalias
    met_a (tap-hold-next-release 200 a lmet)
    alt_s (tap-hold-next-release 200 s lalt)
    sft_d (tap-hold-next-release 200 d lsft)
    ctl_f (tap-hold-next-release 200 f lctl)

    ctl_k (tap-hold-next-release 200 k rctl)
    sft_l (tap-hold-next-release 200 l rsft)
    alt_; (tap-hold-next-release 200 ; lalt)
    met_' (tap-hold-next-release 200 ' rmet)
)

(deflayer homerowmods
    @met_a   @alt_s   @sft_d   @ctl_f   g   h   j   @ctl_k   @sft_l   @alt_;   @met_'
)
